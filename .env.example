# Copy to .env.local for local `npm run dev` / `npm run build`.
# Never commit real secrets — .env.local is gitignored.

# Web3Forms access key — preferred for shared deploys (dev + main)
# https://web3forms.com → your form → Access Key
#
# Set the SAME variable in both places:
#   1. Local:     .env.local (this file after copy)
#   2. Hosting:   Vercel → Settings → Environment Variables
#                 - Production  → builds from `main`
#                 - Preview     → builds from `dev` (and other branches)
# Then redeploy each environment so the key is baked into the static export.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
