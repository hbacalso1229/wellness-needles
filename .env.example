# Copy to .env.local for local `npm run dev` / `npm run build`.
# Never commit real secrets — .env.local is gitignored.

# Web3Forms access key — staging / local checkbox path
# https://web3forms.com → your form → Access Key
#
# Staging: GitHub secret NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY (deploy-to-staging.yml)
# Production: GitHub secret NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY_PRODUCTION
#   baked as NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY on Release (browser → Web3Forms).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Captcha: hCaptcha checkbox (staging and production).
# NEXT_PUBLIC_CAPTCHA_PROVIDER=hcaptcha

# Optional override for Admin nav + /admin (normally auto from git branch):
#   true  → show Admin (default for local next dev and Vercel builds from `dev`)
#   false → hide Admin (default for Vercel builds from `main`)
# NEXT_PUBLIC_ADMIN_UI_ENABLED=
